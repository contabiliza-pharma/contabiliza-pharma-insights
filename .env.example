# .env do contabiliza-insights — API Java + infraestrutura local (Postgres, Redis, pgAdmin)
# Copie de .env.example e preencha. NUNCA versione o .env (Guia §6.6).
# No Railway, estas variáveis são cadastradas no painel do serviço (veja docs/DEPLOY_RAILWAY.md).
# =====================================================================
# SENHAS: ONDE VAI HASH E ONDE VAI TEXTO PURO
#
#  * ADMIN_SENHA_HASH  → é o ÚNICO HASH deste arquivo. É o Argon2id da senha do 1º administrador,
#    gerado pelo comando do README (scripts/gerar-hash-senha.*). A senha em si NUNCA vai para
#    arquivo nenhum: você a digita no comando e depois no login. Fica ENTRE ASPAS SIMPLES
#    (o hash tem "$", que o Docker Compose tentaria interpretar).
#
#  * Todas as outras senhas (DB_*_PASSWORD, REDIS_PASSWORD, PGADMIN_PASSWORD, SMTP_PASSWORD)
#    e o PROCESSAMENTO_TOKEN → TEXTO PURO. São credenciais que os programas apresentam para se
#    conectar ao banco, ao Redis, ao SMTP e ao microsserviço; quem recebe precisa da senha original.
#    NUNCA coloque um hash nelas. Gere com:  openssl rand -hex 24
#
#  * Senhas dos usuários da plataforma (clientes, colaboradores, administradores criados no painel)
#    NÃO ficam aqui: o próprio sistema gera e guarda só o hash Argon2id no banco.
#
#  * Valores que se repetem em outros módulos e precisam ser IGUAIS:
#      DB_APP_PASSWORD     → também no .env do contabiliza-insights-processamento
#      PROCESSAMENTO_TOKEN → também no .env do contabiliza-insights-processamento
# =====================================================================

APP_ENV=dev
# Endereço pelo qual o cliente acessa a web (Docker: WEB_PORT do front; dev: Vite)
APP_URL_PUBLICA=http://localhost:8088
# Origens que podem chamar a API: web no Docker (8088) e Vite em desenvolvimento (5173).
# Produção: só a URL pública da web.
APP_ORIGENS_PERMITIDAS=http://localhost:8088,http://localhost:5173

# ---------- Portas no seu computador ----------
# Valem para ./mvnw spring-boot:run e para as portas publicadas pelo docker-compose deste repositório.
# Dentro do container a API usa sempre 8080/8081 (o compose fixa). No Railway, a porta vem da variável PORT.
API_PORT=8080
MANAGEMENT_PORT=8081
DB_PORT=5434
REDIS_PORT=6380
PGADMIN_PORT=5052

# ---------- Banco (PostgreSQL) ----------
# DB_HOST=localhost para rodar com ./mvnw; o compose troca para "postgres" dentro do container.
DB_HOST=localhost
DB_NAME=relatorios
# Superusuário do container Postgres (só a infraestrutura usa) — texto puro
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=
# Dono das tabelas; só o Flyway usa — texto puro
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=
# Usuário da aplicação (sem DDL), usado pela API e pelo processamento — texto puro, IGUAL no processamento
DB_APP_USER=app_rw
DB_APP_PASSWORD=

# ---------- Redis (sessões e rate limit) ----------
REDIS_HOST=localhost
# Texto puro
REDIS_PASSWORD=

# ---------- pgAdmin (http://localhost:PGADMIN_PORT, abre sem login, só nesta máquina) ----------
# A imagem exige e-mail e senha (texto puro), mas o modo usado não pede login.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ---------- Sessão (cookie HttpOnly) ----------
# Produção (com HTTPS): SESSION_COOKIE_NAME=__Host-session e SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=SESSION
SESSION_COOKIE_SECURE=false

# ---------- Microsserviço de processamento (Python) ----------
# ./mvnw: http://localhost:8000 · Docker: o compose troca para http://processamento:8000
# Railway: http://${{processamento.RAILWAY_PRIVATE_DOMAIN}}:8000
PROCESSAMENTO_URL=http://localhost:8000
# Texto puro, IGUAL no .env do processamento (mínimo 32 caracteres; openssl rand -hex 32)
PROCESSAMENTO_TOKEN=

# ---------- Primeiro administrador (seeder, roda na subida se o e-mail ainda não existir) ----------
ADMIN_NOME=
ADMIN_EMAIL=
# HASH Argon2id (não a senha!), entre aspas simples. Gere com scripts/gerar-hash-senha.sh (ou .ps1).
ADMIN_SENHA_HASH=''

# ---------- E-mail (Google Workspace) — preparado, desligado ----------
EMAIL_MODO=desligado
EMAIL_REMETENTE=
EMAIL_NOME_REMETENTE=ContabilizaPharma
EMAIL_ENVIAR_SENHA_TEMPORARIA=false
# Opção A — EMAIL_MODO=gmail-api (conta de serviço com delegação em todo o domínio)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DELEGATED_USER=
# Opção B — EMAIL_MODO=smtp (SMTP_PASSWORD em texto puro: senha de app ou do relay)
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JSON (ecs) no Docker; vazio = texto legível ao rodar com ./mvnw
LOG_FORMAT=
